# SQLite DB path
DB_PATH=tasks.db

# Checkpoint DB for LangGraph agent memory
CHECKPOINTS_DB_PATH=checkpoints.db

# VECTOR DB - Qdrant (local or cloud)
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# LLM API key (Groq)
GROQ_API_KEY=your-groq-api-key

# HuggingFace token (optional, for private models)
HF_TOKEN=

# User-Agent header for web scraping
USER_AGENT=myapp/1.0

# CORS - comma-separated list of allowed frontend origins (leave empty to allow all, not recommended in production)
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=

# Max PDF upload size in bytes (default: 20971520 = 20 MB)
MAX_UPLOAD_BYTES=20971520
